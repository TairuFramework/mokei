+// Definition references must resolve at the composed message root. Keep ID-qualified resources intact.
+export function rebaseDefinitionReferences(schema) {
+    const maps = new Set(['definitions', '$defs', 'properties', 'patternProperties', 'dependentSchemas', 'dependencies']);
+    const lists = new Set(['allOf', 'anyOf', 'oneOf', 'prefixItems']);
+    const children = new Set(['additionalItems', 'additionalProperties', 'contains', 'contentSchema', 'else', 'if', 'items', 'not', 'propertyNames', 'then', 'unevaluatedItems', 'unevaluatedProperties']);
+    const escape = (key)=>key.replace(/~/g, '~0').replace(/\//g, '~1');
+    function visit(value, path, scopes) {
+        if (value === null || typeof value !== 'object' || Array.isArray(value)) return value;
+        if (typeof value.$id === 'string') return value;
+        const next = value.definitions || value.$defs ? [...scopes, { value, path }] : scopes;
+        return Object.fromEntries(Object.entries(value).map(([key, item])=>{
+            if (key === '$ref' && typeof item === 'string') {
+                const match = /^#\/(definitions|\$defs)\/([^/]+)(.*)$/.exec(item);
+                if (match) {
+                    const name = match[2].replace(/~1/g, '/').replace(/~0/g, '~');
+                    const scope = next.findLast(({ value })=>Object.hasOwn(value[match[1]] ?? {}, name));
+                    if (scope) return [key, `#${scope.path}/${match[1]}/${match[2]}${match[3]}`];
+                }
+            }
+            const childPath = `${path}/${escape(key)}`;
+            if (maps.has(key) && item !== null && typeof item === 'object' && !Array.isArray(item)) {
+                return [key, Object.fromEntries(Object.entries(item).map(([name, child])=>[
+                    name, visit(child, `${childPath}/${escape(name)}`, next)
+                ]))];
+            }
+            if ((lists.has(key) || key === 'items') && Array.isArray(item)) {
+                return [key, item.map((child, index)=>visit(child, `${childPath}/${index}`, next))];
+            }
+            if (children.has(key)) return [key, visit(item, childPath, next)];
+            // Annotations, constants and extension values are data, not schema locations.
+            return [key, item];
+        }));
+    }
+    return visit(schema, '', []);
+}
