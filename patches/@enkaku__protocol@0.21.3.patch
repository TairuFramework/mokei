 import { signedHeaderSchema, signedPayloadSchema, unsignedHeaderSchema } from '@kokuin/token';
+// Definition references must resolve at the composed message root. Keep ID-qualified resources intact.
+export function rebaseDefinitionReferences(schema) {
+    function visit(value, path, scopes) {
+        if (Array.isArray(value)) {
+            return value.map((item, index)=>visit(item, `${path}/${index}`, scopes));
+        }
+        if (value === null || typeof value !== 'object') return value;
+        if (typeof value.$id === 'string') return value;
+        const next = value.definitions || value.$defs ? [...scopes, { value, path }] : scopes;
+        return Object.fromEntries(Object.entries(value).map(([key, item])=>{
+            if (key === '$ref' && typeof item === 'string') {
+                const match = /^#\/(definitions|\$defs)\/([^/]+)(.*)$/.exec(item);
+                if (match) {
+                    const name = match[2].replace(/~1/g, '/').replace(/~0/g, '~');
+                    const scope = next.findLast(({ value })=>Object.hasOwn(value[match[1]] ?? {}, name));
+                    if (scope) return [key, `#${scope.path}/${match[1]}/${match[2]}${match[3]}`];
+                }
+            }
+            const segment = key.replace(/~/g, '~0').replace(/\//g, '~1');
+            return [key, visit(item, `${path}/${segment}`, next)];
+        }));
+    }
+    return visit(schema, '', []);
+}
