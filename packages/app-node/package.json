{
  "name": "@mokei/app-node",
  "version": "0.14.0",
  "description": "Mokei Node app foundation: configuration, database and telemetry",
  "keywords": [
    "model",
    "context",
    "protocol",
    "mcp",
    "node",
    "typesafe"
  ],
  "homepage": "https://mokei.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/TairuFramework/mokei",
    "directory": "packages/app-node"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./lib/index.js"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/*"
  ],
  "scripts": {
    "build": "pnpm run build:clean && pnpm run build:js && pnpm run build:types",
    "build:clean": "del lib",
    "build:js": "del 'lib/**/*.js' && swc src -d ./lib --config-file ../../node_modules/@kigu/dev/swc.json --strip-leading-paths",
    "build:types": "del 'lib/**/*.d.ts' 'lib/**/*.d.ts.map' && tsc --emitDeclarationOnly --skipLibCheck",
    "build:types:ci": "tsc --emitDeclarationOnly --skipLibCheck --declarationMap false",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run test:types && pnpm run test:unit",
    "test:types": "tsc --noEmit --skipLibCheck -p tsconfig.test.json",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@hozon/db": "catalog:",
    "@hozon/logtape": "catalog:",
    "@hozon/otel": "catalog:",
    "@hozon/store-log": "catalog:",
    "@hozon/store-telemetry": "catalog:",
    "@logtape/logtape": "catalog:",
    "@mokei/context-client": "workspace:^",
    "@mokei/host-protocol": "workspace:^",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/context-async-hooks": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@sozai/async": "catalog:",
    "@sozai/json": "catalog:",
    "@sozai/log": "catalog:",
    "@sozai/schema": "catalog:",
    "@tejika/db": "catalog:",
    "@tejika/env": "catalog:",
    "@tejika/log": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
