{
  "mcpServers": {
    "fetch": {
      "command": "node",
      "args": ["mcp-servers/fetch/lib/serve.js"],
      "env": {}
    },
    "sqlite": {
      "command": "node",
      "args": ["mcp-servers/sqlite/lib/serve.js"],
      "env": {}
    },
    "system-one": {
      "command": "node",
      "args": ["mcp-servers/system-one/lib/serve.js"],
      "env": { "SYSTEM_ONE_URL": "http://localhost:8000" }
    }
  }
}
