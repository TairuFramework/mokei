{
  "id": "demo/nested",
  "name": "Demo nested",
  "version": 1,
  "start": "call",
  "nodes": {
    "call": { "kind": "call", "flow": "demo/ask", "version": 1, "next": "route" },
    "route": {
      "kind": "branch",
      "cases": [
        {
          "when": { "path": ["results", "call", "outcome"], "is": { "equalTo": "declined" } },
          "to": "declined"
        }
      ],
      "default": "answered"
    },
    "declined": {
      "kind": "end",
      "outcome": "declined",
      "output": { "output": { "ref": ["results", "call", "output"] } }
    },
    "answered": {
      "kind": "end",
      "outcome": "answered",
      "output": { "output": { "ref": ["results", "call", "output"] } }
    }
  }
}
