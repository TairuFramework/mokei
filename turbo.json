{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "build:js": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/tsconfig.build.json"
      ],
      "outputs": ["lib/**/*.js"]
    },
    "build:types": {
      "dependsOn": ["^build:types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/tsconfig.build.json"
      ],
      "outputs": ["lib/**/*.d.ts", "lib/**/*.d.ts.map"]
    },
    "test:types": {
      "dependsOn": ["^build:types", "build:types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/tsconfig.build.json"
      ]
    },
    "test:unit": {
      "dependsOn": ["^build:js", "build:js"]
    }
  }
}
